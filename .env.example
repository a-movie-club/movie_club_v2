# ─── The shared Supabase project ──────────────────────────────────────────────
# One project serves v1 (live, `public` schema) and v2 (`v2` schema).
# These two values are PUBLIC BY DESIGN — security lives in RLS, not in
# hiding the key. Copy this file to .env.local; .env.local is gitignored.
#
# Vite only exposes variables prefixed with VITE_ to browser code. That prefix
# is a promise that the value is public — never put a secret behind it.

VITE_SUPABASE_URL=https://schtizxdezxteulbvynp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BLeS65tH-8Fxd4nbAX8acA_TAIMtcNn

# The sb_secret_ key and the Supabase personal access token are NOT env vars
# of this app and must never appear in any .env file here — this is a static
# SPA, so anything Vite can see, the browser can see. They live in the repo
# owner's password manager and (when CI needs them) GitHub Actions secrets.
